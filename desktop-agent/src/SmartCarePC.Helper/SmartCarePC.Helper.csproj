<Project Sdk="Microsoft.NET.Sdk">
  <!-- App khay cho Windows 10/11 x64. Build được trên Mac nhờ EnableWindowsTargeting, nhưng chỉ chạy được trên Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SmartCarePCHelper</AssemblyName>
    <RootNamespace>SmartCarePC.Helper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>SmartCarePC Helper</AssemblyTitle>
    <!-- Giữ RAM thấp: GC máy trạm, không chạy GC song song -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- MPL-2.0. Bản 0.9.6 dùng driver PawnIO, không đi kèm và không tự cài driver. Xem README mục "Cảm biến". -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SmartCarePC.Helper.Core/SmartCarePC.Helper.Core.csproj" />
  </ItemGroup>
</Project>
