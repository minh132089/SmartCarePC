              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test",
                "echo"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hello\": \"SmartCarePC\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trả lại đúng body\", () => pm.expect(pm.response.json().received.hello).to.eql(\"SmartCarePC\"));"
