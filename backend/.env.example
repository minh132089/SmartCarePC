# Mẫu cấu hình AI cho backend. Chép file này thành backend/.env rồi điền khoá (backend/.env không đưa lên GitHub).

# Trợ lý AI: API chuẩn OpenAI (đang dùng ViLao.ai, model Claude Haiku)
AI_API_KEY=
AI_BASE_URL=https://api.vilao.ai/v1
AI_MODEL=occ/claude-haiku-5-5

# Tìm sản phẩm thật (ảnh, giá, link mua) cho trang tư vấn: khoá Serper.dev. Để trống thì trợ lý dùng giá ước tính.
SERPER_API_KEY=

# Khoá để nhóm nghiên cứu tải phản hồi thử nghiệm: /api/feedback/export.csv?key=<khoá này>
FEEDBACK_EXPORT_KEY=
